# Optional override for the public origin used by canonical URLs, Open Graph
# tags, sitemap.xml and robots.txt.
#
# You normally do NOT need this. The canonical production domain
# (https://coachlab.in) lives in src/lib/site-url.ts, so production is correct
# with no environment configuration at all.
#
# Set it only to point a deployment somewhere else — a staging host, or after
# a domain change before the code is updated. A bare domain works
# ("coachlab.in" becomes "https://coachlab.in"); a blank value is ignored.
#
# NEXT_PUBLIC_SITE_URL=https://staging.coachlab.in
