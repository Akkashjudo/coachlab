# Public origin used for canonical URLs, Open Graph tags, sitemap.xml and
# robots.txt.
#
# Optional on Vercel: if this is not set, the site falls back to Vercel's own
# production domain, then to http://localhost:3000. Set it once you have a
# real domain so canonicals point there rather than at *.vercel.app.
#
# A bare domain works too — "coachlab.in" is normalised to
# "https://coachlab.in". Leaving the value blank is treated as "not set".
NEXT_PUBLIC_SITE_URL=https://your-domain.com
